{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gyre",
  "version": "0.1.0",
  "identifier": "dev.gyre.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "A desktop surface for the omp coding agent",
    "longDescription": "Gyre is a tiled, keyboard-first desktop UI for the omp (oh-my-pi) coding agent. omp must be installed separately.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/gyre-gateway"],
    "resources": {
      "../../../packages/web/dist/": "web/",
      "../../../packages/omp-extension/src/": "omp-extension/src/"
    }
  }
}
